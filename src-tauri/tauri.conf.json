{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bible-app",
  "version": "0.2.0",
  "identifier": "com.kyere.bible-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bible-app",
        "width": 800,
        "height": 600
      },
      {
        "label": "projection",
        "title": "Projection",
        "width": 960,
        "height": 540,
        "visible": false,
        "decorations": false
      },
      {
        "label": "stage",
        "title": "Stage Display",
        "width": 800,
        "height": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/*.canonical.json": "data/",
      "../bundled/models/*.bin": "models/",
      "../bundled/bin/*": "bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../EULA.rtf"
  }
}
